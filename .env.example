# ===========================================================================
# BlueScout 1086 — environment variables. Copy to .env and fill in.
# ===========================================================================

# Postgres connection. For local dev, `docker compose up db` provides this.
# For production, point at your team's remote Postgres server.
DATABASE_URL="postgresql://bluescout:bluescout@localhost:5432/bluescout?schema=public"

# Redis (Socket.IO scaling + caching + BullMQ). `docker compose up redis` provides this.
REDIS_URL="redis://localhost:6379"

# Session signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The Blue Alliance API v3 read key (https://www.thebluealliance.com/account).
TBA_AUTH_KEY=""
TBA_BASE_URL="https://www.thebluealliance.com/api/v3"

# Statbotics v3 REST API (public, no key required).
STATBOTICS_BASE_URL="https://api.statbotics.io/v3"

# The event currently being scouted, e.g. 2026wabon. Optional.
CURRENT_EVENT_KEY=""

# ---------------------------------------------------------------------------
# AI agents — DISABLED by default in v1. To enable natural-language Q&A,
# qualitative note summaries, and picklist suggestions:
#   1. Set AI_ENABLED="true"
#   2. Set AI_PROVIDER to anthropic | openai | deepseek | nvidia | ollama
#   3. Provide the matching key/url below.
# ---------------------------------------------------------------------------
AI_ENABLED="false"
AI_PROVIDER="none"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# NVIDIA NIM (reasoning model). NVIDIA_THINKING="false" disables the thinking pass.
NVIDIA_API_KEY=""
NVIDIA_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_THINKING="true"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
